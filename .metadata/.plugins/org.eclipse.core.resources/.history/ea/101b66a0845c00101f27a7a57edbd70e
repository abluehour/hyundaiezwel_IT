<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>마우스 이벤트</title>
		<script type="text/javascript">
			window.onload = function(){
				let birdimg = document.getElementById("bridImg");
				
				//객체로 마우스 포인터가 진입하는 경우 발생
				birdimg.onmouseover = () => {
					birdimg.style.opacity=0.5;
				};
				
				//객체에서 마우스 포인터가 벗어나는 경우 발생
				birdimg.onmouseout = () => {
					birdimg.style.opacity = 1;
				}
				
			};
			
			// 문서 상에서 오른쪽 마우스 클릭했을 때 이벤트 처리 : contextmenu

		</script>
	</head>
	<body>
		<img id="birdImg" src="image/bird.jpg">
	</body>
</html>





