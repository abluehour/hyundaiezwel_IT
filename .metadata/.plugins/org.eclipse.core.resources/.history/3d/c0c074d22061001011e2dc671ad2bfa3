@charset "UTF-8";

#chatHeader {
    padding: 10px 15px;
    width: 500px;
    border-bottom: 1px solid;
}

#closeBtn {
    border: none;
    background: none;
    float: right;
}

/* 메시지 창 */
#chatBox {
    display: flex;
    flex-direction: column;
    width: 500px;
    height: 600px;
    overflow-y: scroll;
    padding: 10px 15px;
    background: #9bbbd4;
}

/* input 입력란 */
#message {
    width: 400px;
    height: 30px;
    float: left;
    margin-top:10px;
}

#submitBtn{
	float:right;
	width: 80px;
	height: 30px;
	border: none;
	background:yellow;
	color:black;
	margin-top:10px;
	padding-left:10px;
	padding-right:10px;
	padding:10px;
	border-radius:5px;
}

/* 동적으로 생성되는 객체들에 대한 css: append()되는 태그에 동작 클래스 적용 */

.msgBox{/*입력한 메시지가 출력될 박스*/
	padding: 3px 5px;
	word-break: break-all;
	max-width:300px;
	margin-bottom:10px;
	border-radius:10px;
	
}

