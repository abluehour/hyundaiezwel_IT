<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>event_ex3 연습문제</title>
		<style>
			div {
				width:100px;
				height:50px;
				line-height:50px;
				text-align:center;
				color:white;
				background-color:teal;
				border-radius:20px;
			} 
		</style>
		<script src="jquery-3.7.1.min.js"></script>
		<script type="text/javascript">
		$(document).ready(function(){
			// div 버튼을 클릭했을때 버튼 2개를 추가하는 코드
			$('div').on('click', function(){
				// 새버튼 2개 생성
				$(this).after("<p><input type='button' id='newBtn1' value='새버튼1'>"+
									  "<p><input type='button' id='newBtn2' value='새버튼2'>");					
			})
			
			// 새 버튼1 이벤트
			$(document).on('mouseenter', '#newBtn1', function(){
				$(this).css('background-color', 'green');  // 마우스 올리면 배경색이 초록색으로 변경
			});

			$(document).on('mouseleave', '#newBtn1', function(){
				$(this).css('background-color', 'yellow');  // 마우스가 벗어나면 배경색이 노란색으로 변경
			});

			$(document).on('click', '#newBtn1', function(){
				window.open('https://www.naver.com', '_blank');  // 클릭 시 새 창에서 사이트 열기
			});
			
			// 새 버튼2 이벤트
			$(document).on('mouseenter', '#newBtn2', function(){
				$(this).css('background-color', 'green');  // 마우스 올리면 배경색이 초록색으로 변경
			});

			$(document).on('mouseleave', '#newBtn2', function(){
				$(this).css('background-color', 'yellow');  // 마우스가 벗어나면 배경색이 노란색으로 변경
			});

			$(document).on('click', '#newBtn2', function(){
				window.open('https://www.naver.com', '_blank');  // 클릭 시 새 창에서 다른 사이트 열기
			});
		});
			
		</script>			
	</head>
	<body>
		<div>버튼</div>
	</body>
</html>