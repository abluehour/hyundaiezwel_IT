<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>DOM : attr() : 속성 변경</title>
		<style type="text/css">
			div {margin:0 auto; width:800px;}
			img {width:200px; height:100px;}			
		</style>
		
		<script src="jquery-3.7.1.min.js"></script>
		<script type="text/javascript">
			$(document).ready(function() {
				// <img> 태그에 마우스를 올렸을 때
				$('#img2')
				.on('mouseover', function(){
					$(this).attr('src','image/img2-2.jpg');
				})
				// <img> 태그에서 마우스를 내렸을 때
				.on('mouseout', function(){
					$(this).attr('src','image/img1-2.jpg');
				});
				// <img> 태그에 마우스를 올렸을 때
				$('#img4')
				.on('mouseover', function(){
					$(this).attr('src','image/img4-4.jpg');
				})
				// <img> 태그에서 마우스를 내렸을 때
				.on('mouseout', function(){
					$(this).attr('src','image/img1-4.jpg');
				});
			})
		</script>
	</head>
	<body>
		<div><img src = "image/img1-1.jpg"><img id='img2' src = "image/img1-2.jpg"><img src = "image/img1-3.jpg"><img id='img4' src = "image/img1-4.jpg"></div>		
	</body>

</html>