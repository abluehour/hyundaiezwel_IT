<!DOCTYPE html>
<html>
   <head>
      <meta charset="UTF-8">
      <title>Insert title here</title>
      <script src="jquery-3.7.1.min.js"></script>
      <script type="text/javascript">   
      		// 태그의 id속성 참조
      		window.onload = () =>{
      			btn.onclick = () => {
      				title.innerHTML = "변경된 제목"; //태그의 id 속성은 적
      			}
      		}
      </script>
   </head>
   <body>
   		<h1 id="title">제목</h1>
   		<button id="btn">변경</button>
   </body>
</html>